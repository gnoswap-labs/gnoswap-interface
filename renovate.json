{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":approveMajorUpdates"
  ],
  "automerge": false,
  "prConcurrentLimit": 3,
  "addLabels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/*",
        "@typescript-eslint/*",
        "typescript-eslint",
        "eslint-*",
        "!eslint-config-next",
        "!eslint-plugin-storybook",
        "prettier",
        "lint-staged"
      ],
      "groupName": "Lint and format tooling",
      "groupSlug": "lint-format-tooling"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "jest",
        "jest-*",
        "@jest/*",
        "@types/jest",
        "babel-jest",
        "ts-jest",
        "@testing-library/*"
      ],
      "groupName": "Test tooling",
      "groupSlug": "test-tooling"
    }
  ]
}
